# Скопируйте в .env и при необходимости измените значения
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=valdex_check
POSTGRES_USER=valdex
POSTGRES_PASSWORD=valdex
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Режим источника: mock | api | web (по умолчанию mock)
SOURCE_MODE_EGRUL=mock
SOURCE_MODE_TRANSPARENT=mock
SOURCE_MODE_DISQUALIFIED=mock
SOURCE_MODE_FSSP=mock
SOURCE_MODE_EFRSB=mock
SOURCE_MODE_KAD=mock
SOURCE_MODE_CBR=mock

# Ключ API для ЕГРЮЛ в режиме api (например, DaData); не коммитить
EGRUL_API_KEY=

# Бесплатные подключения ФССП, сообщений ЕФРСБ и арбитража через Офдата v2.
# При наличии ключа профиль «Реальная проверка» автоматически использует API для этих трёх источников.
OFDATA_API_KEY=
# Локальный предел запросов в сутки; максимум 100, по умолчанию 90 с запасом.
OFDATA_DAILY_LIMIT=90

# Доверенные корни/промежуточные сертификаты и CRL в PEM, установленные администратором.
# Пустое значение не означает подтверждения доверия к сертификату подписи.
SIGNATURE_TRUST_BUNDLE=

# Переопределение весов и порогов скоринга: RISK_<КЛЮЧ из SCORING_CONFIG>, целое число. Например:
# RISK_LOST_AMOUNT_OVER=2000000
