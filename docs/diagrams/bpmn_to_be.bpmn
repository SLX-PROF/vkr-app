<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="bpmn_to_be" targetNamespace="https://vkr.local/process"><bpmn:process id="process" isExecutable="false"><bpmn:laneSet id="lanes"><bpmn:lane id="staff" name="Сотрудник"><bpmn:flowNodeRef>start</bpmn:flowNodeRef><bpmn:flowNodeRef>input</bpmn:flowNodeRef><bpmn:flowNodeRef>review</bpmn:flowNodeRef><bpmn:flowNodeRef>end</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="system" name="ИС"><bpmn:flowNodeRef>collect</bpmn:flowNodeRef><bpmn:flowNodeRef>score</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="start" name="Получен запрос"><bpmn:outgoing>flow0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="input" name="Ввести ИНН / ОГРН"><bpmn:incoming>flow0</bpmn:incoming><bpmn:outgoing>flow1</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="collect" name="Получить данные из источников"><bpmn:incoming>flow1</bpmn:incoming><bpmn:outgoing>flow2</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="score" name="Оценить риск и сохранить сеанс"><bpmn:incoming>flow2</bpmn:incoming><bpmn:outgoing>flow3</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="review" name="Изучить результат и принять решение"><bpmn:incoming>flow3</bpmn:incoming><bpmn:outgoing>flow4</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="end" name="Решение принято"><bpmn:incoming>flow4</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="flow0" sourceRef="start" targetRef="input" /><bpmn:sequenceFlow id="flow1" sourceRef="input" targetRef="collect" /><bpmn:sequenceFlow id="flow2" sourceRef="collect" targetRef="score" /><bpmn:sequenceFlow id="flow3" sourceRef="score" targetRef="review" /><bpmn:sequenceFlow id="flow4" sourceRef="review" targetRef="end" /></bpmn:process><bpmndi:BPMNDiagram id="diagram"><bpmndi:BPMNPlane id="plane" bpmnElement="process"><bpmndi:BPMNShape id="staff_shape" bpmnElement="staff" isHorizontal="true"><dc:Bounds x="30" y="60" width="1740" height="370" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="system_shape" bpmnElement="system" isHorizontal="true"><dc:Bounds x="30" y="430" width="1740" height="420" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="start_shape" bpmnElement="start"><dc:Bounds x="290" y="235" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="input_shape" bpmnElement="input"><dc:Bounds x="410" y="170" width="270" height="180" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="collect_shape" bpmnElement="collect"><dc:Bounds x="760" y="540" width="320" height="180" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="score_shape" bpmnElement="score"><dc:Bounds x="1200" y="540" width="330" height="180" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="review_shape" bpmnElement="review"><dc:Bounds x="1200" y="170" width="330" height="180" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="end_shape" bpmnElement="end"><dc:Bounds x="1650" y="235" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="edge0" bpmnElement="flow0"><di:waypoint x="340" y="260" /><di:waypoint x="410" y="260" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="edge1" bpmnElement="flow1"><di:waypoint x="680" y="260" /><di:waypoint x="920" y="260" /><di:waypoint x="920" y="540" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="edge2" bpmnElement="flow2"><di:waypoint x="1080" y="630" /><di:waypoint x="1200" y="630" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="edge3" bpmnElement="flow3"><di:waypoint x="1365" y="540" /><di:waypoint x="1365" y="350" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="edge4" bpmnElement="flow4"><di:waypoint x="1530" y="260" /><di:waypoint x="1650" y="260" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>