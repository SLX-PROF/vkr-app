<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="bpmn_as_is" targetNamespace="https://vkr.local/process"><bpmn:process id="process" isExecutable="false"><bpmn:laneSet id="lanes"><bpmn:lane id="staff" name="Сотрудник"><bpmn:flowNodeRef>start</bpmn:flowNodeRef><bpmn:flowNodeRef>tax</bpmn:flowNodeRef><bpmn:flowNodeRef>sign</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="system" name="Руководитель"><bpmn:flowNodeRef>decision</bpmn:flowNodeRef><bpmn:flowNodeRef>end</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="start" name="Получены документы"><bpmn:outgoing>flow0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="tax" name="Проверить недоимку на сайте ФНС"><bpmn:incoming>flow0</bpmn:incoming><bpmn:outgoing>flow1</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="sign" name="Вручную проверить подписанта"><bpmn:incoming>flow1</bpmn:incoming><bpmn:outgoing>flow2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="decision" name="Решить вопрос о сотрудничестве"><bpmn:incoming>flow2</bpmn:incoming><bpmn:outgoing>flow3</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="end" name="Документы приняты или возвращены"><bpmn:incoming>flow3</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="flow0" sourceRef="start" targetRef="tax" /><bpmn:sequenceFlow id="flow1" sourceRef="tax" targetRef="sign" /><bpmn:sequenceFlow id="flow2" sourceRef="sign" targetRef="decision" /><bpmn:sequenceFlow id="flow3" sourceRef="decision" targetRef="end" /></bpmn:process><bpmndi:BPMNDiagram id="diagram"><bpmndi:BPMNPlane id="plane" bpmnElement="process"><bpmndi:BPMNShape id="staff_shape" bpmnElement="staff" isHorizontal="true"><dc:Bounds x="30" y="60" width="1740" height="370" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="system_shape" bpmnElement="system" isHorizontal="true"><dc:Bounds x="30" y="430" width="1740" height="420" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="start_shape" bpmnElement="start"><dc:Bounds x="290" y="235" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="tax_shape" bpmnElement="tax"><dc:Bounds x="400" y="170" width="300" height="180" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="sign_shape" bpmnElement="sign"><dc:Bounds x="820" y="170" width="300" height="180" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="decision_shape" bpmnElement="decision"><dc:Bounds x="1220" y="540" width="300" height="180" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="end_shape" bpmnElement="end"><dc:Bounds x="1650" y="605" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="edge0" bpmnElement="flow0"><di:waypoint x="340" y="260" /><di:waypoint x="400" y="260" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="edge1" bpmnElement="flow1"><di:waypoint x="700" y="260" /><di:waypoint x="820" y="260" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="edge2" bpmnElement="flow2"><di:waypoint x="1120" y="260" /><di:waypoint x="1370" y="260" /><di:waypoint x="1370" y="540" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="edge3" bpmnElement="flow3"><di:waypoint x="1520" y="630" /><di:waypoint x="1650" y="630" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>